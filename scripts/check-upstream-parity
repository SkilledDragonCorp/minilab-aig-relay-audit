#!/usr/bin/env python3
"""Diff run: lines in upstream-ci.yml against committed ci/upstream/go-test.yml."""

from __future__ import annotations

import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
UPSTREAM_COPY = ROOT / "ci" / "upstream" / "go-test.yml"
LAB_WORKFLOW = ROOT / ".github" / "workflows" / "upstream-ci.yml"
PIN = "5ec95d4cd350f1982c0be71848463b07614e6e9d"

RUN_LINE = re.compile(r"^\s*-\s*run:\s*(.*)$|^\s*run:\s*(.*)$")

# Lab-owned extras allowed beyond verbatim upstream run lines.
ALLOWED_EXTRA_PREFIXES = (
    f"git -C upstream rev-parse HEAD | grep -qx {PIN}",
    "python3 -m venv services/api_checker/.venv",
    "services/api_checker/.venv/bin/pip install",
    "services/api_checker/.venv/bin/python -m pytest",
)

ALLOWED_EXACT_RUNS = {
    "go build ./...",
    "go test ./... -count=1",
}


def _extract_runs(text: str) -> list[str]:
    runs: list[str] = []
    lines = text.splitlines()
    i = 0
    while i < len(lines):
        line = lines[i]
        match = RUN_LINE.match(line)
        if not match:
            i += 1
            continue
        value = (match.group(1) or match.group(2) or "").strip()
        if value in {"|", ">"}:
            block: list[str] = []
            i += 1
            while i < len(lines):
                nxt = lines[i]
                if re.match(r"^\s{2,}\S", nxt) and not re.match(
                    r"^\s*(?:-\s+)?(?:name:|uses:|with:|env:|if:|working-directory:|run:)",
                    nxt,
                ):
                    block.append(nxt.strip())
                    i += 1
                    continue
                break
            runs.append("\n".join(block))
            continue
        runs.append(value.strip("\"'"))
        i += 1
    return runs


def main() -> int:
    if not UPSTREAM_COPY.is_file():
        print(f"missing {UPSTREAM_COPY}", file=sys.stderr)
        return 1
    if not LAB_WORKFLOW.is_file():
        print(f"missing {LAB_WORKFLOW}", file=sys.stderr)
        return 1

    upstream_runs = set(_extract_runs(UPSTREAM_COPY.read_text(encoding="utf-8")))
    lab_runs = _extract_runs(LAB_WORKFLOW.read_text(encoding="utf-8"))

    required = {"go build ./...", "go test ./... -count=1"}
    missing = sorted(r for r in required if r not in set(lab_runs))
    unexpected: list[str] = []
    for run in lab_runs:
        if run in upstream_runs or run in ALLOWED_EXACT_RUNS:
            continue
        if any(run.startswith(prefix) for prefix in ALLOWED_EXTRA_PREFIXES):
            continue
        if PIN in run and "rev-parse" in run:
            continue
        unexpected.append(run)

    errors: list[str] = []
    if missing:
        errors.append("missing required upstream run lines:")
        errors.extend(f"  - {m!r}" for m in missing)
    if unexpected:
        errors.append("unlisted run: differences in upstream-ci.yml:")
        errors.extend(f"  - {u!r}" for u in unexpected)

    if errors:
        print("\n".join(errors), file=sys.stderr)
        return 1
    print("upstream-parity OK")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
