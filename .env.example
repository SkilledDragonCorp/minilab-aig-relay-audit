# Optional: Google AI Studio key for the known-good Gemini baseline slice.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: OpenAI-compatible relay you own (spend-capped key).
RELAY_BASE_URL=
RELAY_API_KEY=
RELAY_MODEL=

# Lab-only: allow http://127.0.0.1:<port> for keyless mock tests.
RELAY_AUDIT_ALLOW_LOCAL_HTTP=

# Upstream api-checker serve (set ONLY against local mock relays in tests).
AIG_API_CHECKER_ALLOW_HTTP=
AIG_API_CHECKER_ALLOW_PRIVATE_TARGETS=
AIG_API_CHECKER_MAX_JOBS=
AIG_API_CHECKER_LOG_LEVEL=
AIG_API_CHECKER_CORS_ORIGINS=
AIG_API_CHECKER_ROOT_PATH=
HOST=
PORT=
AIG_API_CHECKER_PYTHON=
